import QtQuick
import Mixxx 1.0 as Mixxx

// [AI-GENERATED DISCLAIMER START: Autonomously generated by an AI agent]
// The vinyl control of a deck, for the VINYL buttons of the skins. They are
// only shown when a sound card input is routed to the deck (see Settings,
// Timecode / DVS) or it is on. Tap: on / off, hold: the next mode.
Item {
    id: root

    required property string group
    readonly property int deckIndex: parseInt(group.replace(/[^0-9]/g, "")) - 1
    readonly property bool on: enabledControl.value > 0
    readonly property int mode: modeControl.value
    readonly property string modeName: ["ABS", "REL", "CONST"][mode] || ""
    readonly property int status: statusControl.value
    // Green: good signal, orange: weak, red: lost
    readonly property color statusColor: status >= 3 ? "#e53935" : status >= 2 ? "#fb8c00" : "#43a047"
    property bool routed: false
    readonly property bool shown: routed || on

    function toggle() {
        enabledControl.value = root.on ? 0 : 1;
    }
    function nextMode() {
        Mixxx.MobileAudio.setVinylDeckSettings(root.deckIndex, {
            "mode": (root.mode + 1) % 3
        });
    }

    visible: false

    Mixxx.ControlProxy {
        id: enabledControl

        group: root.group
        key: "vinylcontrol_enabled"
    }
    Mixxx.ControlProxy {
        id: modeControl

        group: root.group
        key: "vinylcontrol_mode"
    }
    Mixxx.ControlProxy {
        id: statusControl

        group: root.group
        key: "vinylcontrol_status"
    }
    // The routing is changed in the settings: checked now and then
    Timer {
        interval: 3000
        repeat: true
        running: root.deckIndex >= 0
        triggeredOnStart: true

        onTriggered: root.routed = !!Mixxx.MobileAudio.vinylDeckSettings(root.deckIndex).inputConnected
    }
}
// [AI-GENERATED DISCLAIMER END: Autonomously generated by an AI agent]
