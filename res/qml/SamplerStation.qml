        const str = urlValue.toString();
        if (str.length === 0) {
            return "";
        }
        const slash = str.lastIndexOf("/");
        const tail = slash >= 0 ? str.substring(slash + 1) : str;
        try {
            return decodeURIComponent(tail);
        } catch (e) {
            return tail;
        }
    }

