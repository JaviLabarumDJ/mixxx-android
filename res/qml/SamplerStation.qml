    function updateSlotFlags(slotIndex, isPlaying, isLoaded) {
        const bankBit = (1 << (slotIndex % 8));
        if (slotIndex < 8) {
            playingMaskA = isPlaying ? (playingMaskA | bankBit) : (playingMaskA & ~bankBit);
        } else {
            playingMaskB = isPlaying ? (playingMaskB | bankBit) : (playingMaskB & ~bankBit);
        }
