import QtQuick
import QtQuick.Layouts
import Mixxx 1.0 as Mixxx
import ".." as Skin

// [AI-GENERATED DISCLAIMER START: Autonomously generated by an AI agent]
// Vinyl control (Android): turntables or CDJs playing timecode vinyls or CDs
// control the decks, through the inputs of a sound card (e.g. a DJ mixer
// with USB). Like the vinyl preferences of the desktop.
Category {
    id: root

    label: qsTr("Timecode / DVS")
    selectedIndex: 0

    readonly property var vinylTypes: Mixxx.MobileAudio.vinylTypes()
    property int gainDb: Mixxx.MobileAudio.vinylGainDb()

    Mixxx.ControlProxy {
        id: numDecks

        group: "[App]"
        key: "num_decks"
    }

    Flickable {
        anchors.fill: parent
        contentHeight: column.implicitHeight + 30
        clip: true
        boundsBehavior: Flickable.StopAtBounds

        ColumnLayout {
            id: column

            anchors.left: parent.left
            anchors.right: parent.right
            anchors.margins: 12
            spacing: 12

            // ================= WHAT IT IS =================
            Card {
                ColumnLayout {
                    anchors.fill: parent
                    anchors.margins: 12
                    spacing: 6

                    Text {
                        text: qsTr("💿 TIMECODE / DVS")
                        font.bold: true
                        font.pixelSize: 13
                        color: "#00e5ff"
                    }
                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: "#cfd8dc"
                        font.pixelSize: 11
                        text: qsTr("Play the decks with turntables or CDJs and timecode vinyls or CDs (Serato, Traktor, Rekordbox DVS, MixVibes...). They need a sound card with an input for each one, e.g. a DJ mixer with USB like the DJM-250MK2: one stereo input per turntable or CDJ.")
                    }
                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: "#90a4ae"
                        font.pixelSize: 11
                        text: qsTr("1. In Audio & Outputs, full routing, Input tab: give \"Vinyl control 1\" and \"Vinyl control 2\" the inputs of the sound card (e.g. channels 1 - 2 and 3 - 4). 2. Choose the timecode of each deck below. 3. Turn VINYL on in the deck.")
                    }
                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: "#ffb74d"
                        font.pixelSize: 11
                        text: qsTr("⚠ The inputs of the mixer must be set to USB / PC (not to the turntable or CDJ directly), and turntables need the PHONO input. Test it before playing live.")
                    }
                    Text {
                        Layout.fillWidth: true
                        wrapMode: Text.WordWrap
                        color: "#ffb74d"
                        font.pixelSize: 11
                        text: qsTr("⚠ Sound cards with more than 2 inputs (e.g. the DJM-250MK2) are recorded by Mixxx' own USB driver. For a card with 2 inputs, set Audio & Outputs → Mixxx USB driver to ALWAYS and restart Mixxx: the inputs of Android's audio don't open on many devices.")
                    }
                }
            }

            // ================= DECKS =================
            Repeater {
                model: Math.max(2, Math.min(4, numDecks.value || 2))

                DeckCard {
                    required property int index

                    deck: index
                }
            }

            // ================= SIGNAL =================
            Card {
                ColumnLayout {
                    anchors.fill: parent
                    anchors.margins: 12
                    spacing: 10

                    Text {
                        text: qsTr("📶 SIGNAL")
                        font.bold: true
                        font.pixelSize: 13
                        color: "#00e5ff"
                    }
                    Stepper {
                        label: qsTr("Input boost")
                        hint: qsTr("Raise it if the signal circle is small or broken (quiet turntables or long cables)")
                        value: root.gainDb
                        min: 0
                        max: 44
                        step: 2
                        suffix: " dB"

                        onChanged: newValue => {
                            Mixxx.MobileAudio.setVinylGainDb(newValue);
                            root.gainDb = newValue;
                        }
                    }
                }
            }
        }
    }

    // The settings of a deck, with the live signal of its timecode
    component DeckCard: Card {
        id: deckCard

        property int deck: 0
        readonly property string group: "[Channel" + (deck + 1) + "]"
        property var settings: Mixxx.MobileAudio.vinylDeckSettings(deck)

        function save(changes) {
            Mixxx.MobileAudio.setVinylDeckSettings(deck, changes);
            deckCard.settings = Mixxx.MobileAudio.vinylDeckSettings(deck);
        }

        Mixxx.ControlProxy {
            id: enabledControl

            group: deckCard.group
            key: "vinylcontrol_enabled"
        }
        Mixxx.ControlProxy {
            id: modeControl

            group: deckCard.group
            key: "vinylcontrol_mode"
        }
        Mixxx.ControlProxy {
            id: cueingControl

            group: deckCard.group
            key: "vinylcontrol_cueing"
        }
        Mixxx.ControlProxy {
            id: statusControl

            group: deckCard.group
            key: "vinylcontrol_status"
        }

        // The routing may change in the audio settings meanwhile
        onVisibleChanged: {
            if (visible) {
                deckCard.settings = Mixxx.MobileAudio.vinylDeckSettings(deck);
            }
        }

        RowLayout {
            anchors.fill: parent
            anchors.margins: 12
            spacing: 12

            ColumnLayout {
                Layout.fillWidth: true
                spacing: 10

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10

                    Text {
                        text: qsTr("DECK %1").arg(deckCard.deck + 1)
                        font.bold: true
                        font.pixelSize: 13
                        color: "#00e5ff"
                    }
                    Text {
                        Layout.fillWidth: true
                        elide: Text.ElideRight
                        font.pixelSize: 11
                        color: deckCard.settings.inputConnected ? "#81c784" : "#ffb74d"
                        text: deckCard.settings.inputConnected ? qsTr("● input routed") : qsTr("● no input routed: see the steps above")
                    }
                    Skin.Button {
                        implicitWidth: 96
                        implicitHeight: 32
                        activeColor: "#ffffff"
                        backgroundColor: enabledControl.value > 0 ? "#1b5e20" : "#222733"
                        normalColor: enabledControl.value > 0 ? "#ffffff" : "#90a4ae"
                        highlight: enabledControl.value > 0
                        font.bold: true
                        font.pixelSize: 11
                        text: enabledControl.value > 0 ? qsTr("VINYL ON") : qsTr("VINYL OFF")
                        onClicked: enabledControl.value = enabledControl.value > 0 ? 0 : 1
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 8

                    Text {
                        Layout.preferredWidth: 130
                        text: qsTr("Timecode")
                        color: "#ffffff"
                        font.pixelSize: 12
                    }
                    Skin.ComboBox {
                        Layout.fillWidth: true
                        Layout.preferredHeight: 34
                        model: root.vinylTypes
                        currentIndex: root.vinylTypes.indexOf(deckCard.settings.type)

                        onActivated: index => {
                            const type = root.vinylTypes[index];
                            deckCard.save({
                                "type": type,
                                "leadIn": Mixxx.MobileAudio.vinylDefaultLeadIn(type)
                            });
                        }
                    }
                }

                ChoiceRow {
                    label: qsTr("Speed")
                    hint: qsTr("Of the record; CDJs play like 33")
                    value: String(deckCard.settings.speed)
                    choices: [
                        {value: "33", text: "33⅓"},
                        {value: "45", text: "45"}
                    ]
                    onChosen: value => deckCard.save({"speed": Number(value)})
                }

                ChoiceRow {
                    label: qsTr("Mode")
                    hint: qsTr("ABS: the needle position is the track position. REL: only the speed, needle drops don't jump. CONST: plays on at a constant speed")
                    value: String(modeControl.value)
                    choices: [
                        {value: "0", text: "ABS"},
                        {value: "1", text: "REL"},
                        {value: "2", text: "CONST"}
                    ]
                    onChosen: value => deckCard.save({"mode": Number(value)})
                }

                ChoiceRow {
                    label: qsTr("Cueing")
                    hint: qsTr("In REL mode, dropping the needle can jump to the cue point (ONE) or to the nearest hotcue (HOT)")
                    value: String(cueingControl.value)
                    choices: [
                        {value: "0", text: "OFF"},
                        {value: "1", text: "ONE"},
                        {value: "2", text: "HOT"}
                    ]
                    onChosen: value => deckCard.save({"cueing": Number(value)})
                }

                Stepper {
                    label: qsTr("Lead-in")
                    hint: qsTr("Seconds at the start of the record that aren't used")
                    value: deckCard.settings.leadIn || 0
                    min: 0
                    max: 120
                    step: 1
                    suffix: " s"

                    onChanged: newValue => deckCard.save({"leadIn": newValue})
                }
            }

            // The circle of the timecode: round and green is a good signal
            ColumnLayout {
                Layout.alignment: Qt.AlignTop
                spacing: 4

                Rectangle {
                    Layout.preferredWidth: 110
                    Layout.preferredHeight: 110
                    color: "#0e1118"
                    radius: 6
                    border.color: "#282d3b"

                    Mixxx.VinylSignalQuality {
                        anchors.fill: parent
                        anchors.margins: 4
                        group: deckCard.group
                        active: enabledControl.value > 0 && deckCard.visible
                    }
                    Text {
                        anchors.centerIn: parent
                        visible: enabledControl.value <= 0
                        width: parent.width - 12
                        horizontalAlignment: Text.AlignHCenter
                        wrapMode: Text.WordWrap
                        color: "#546e7a"
                        font.pixelSize: 10
                        text: qsTr("Turn VINYL on to see the signal")
                    }
                }
                Text {
                    Layout.preferredWidth: 110
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    font.pixelSize: 10
                    color: statusControl.value >= 3 ? "#ef9a9a" : statusControl.value >= 2 ? "#ffb74d" : statusControl.value >= 1 ? "#81c784" : "#78909c"
                    text: statusControl.value >= 3 ? qsTr("Signal lost") : statusControl.value >= 2 ? qsTr("Weak signal") : statusControl.value >= 1 ? qsTr("Signal OK") : qsTr("No signal")
                }
            }
        }
    }

    component Card: Rectangle {
        default property alias content: holder.data

        Layout.fillWidth: true
        implicitHeight: (holder.children.length > 0 ? holder.children[0].implicitHeight : 0) + 24
        color: "#181b24"
        radius: 8
        border.color: "#282d3b"
        border.width: 1

        Item {
            id: holder

            anchors.fill: parent
        }
    }

    // A row of buttons to choose one value
    component ChoiceRow: RowLayout {
        id: choiceRow

        property string label
        property string hint: ""
        property string value
        property var choices: []

        signal chosen(string value)

        Layout.fillWidth: true
        spacing: 8

        ColumnLayout {
            Layout.fillWidth: true
            spacing: 1

            Text {
                Layout.fillWidth: true
                text: choiceRow.label
                color: "#ffffff"
                font.pixelSize: 12
            }
            Text {
                Layout.fillWidth: true
                visible: choiceRow.hint !== ""
                text: choiceRow.hint
                color: "#78909c"
                font.pixelSize: 10
                wrapMode: Text.WordWrap
            }
        }

        Repeater {
            model: choiceRow.choices

            Skin.Button {
                required property var modelData

                implicitWidth: 64
                implicitHeight: 32
                activeColor: "#ffffff"
                backgroundColor: choiceRow.value === modelData.value ? "#1e3a5f" : "#222733"
                normalColor: choiceRow.value === modelData.value ? "#ffffff" : "#90a4ae"
                highlight: choiceRow.value === modelData.value
                font.bold: true
                font.pixelSize: 11
                text: modelData.text
                onClicked: choiceRow.chosen(modelData.value)
            }
        }
    }

    // A number with − and + buttons
    component Stepper: RowLayout {
        id: stepper

        property string label
        property string hint: ""
        property int value: 0
        property int min: 0
        property int max: 100
        property int step: 1
        property string suffix: ""

        signal changed(int newValue)

        Layout.fillWidth: true
        spacing: 8

        ColumnLayout {
            Layout.fillWidth: true
            spacing: 1

            Text {
                Layout.fillWidth: true
                text: stepper.label
                color: "#ffffff"
                font.pixelSize: 12
            }
            Text {
                Layout.fillWidth: true
                visible: stepper.hint !== ""
                text: stepper.hint
                color: "#78909c"
                font.pixelSize: 10
                wrapMode: Text.WordWrap
            }
        }
        Skin.Button {
            implicitWidth: 40
            implicitHeight: 32
            activeColor: "#ffffff"
            enabled: stepper.value > stepper.min
            font.bold: true
            text: "−"
            onClicked: stepper.changed(Math.max(stepper.min, stepper.value - stepper.step))
        }
        Text {
            Layout.preferredWidth: 64
            horizontalAlignment: Text.AlignHCenter
            color: "#ffffff"
            font.bold: true
            font.pixelSize: 13
            text: stepper.value + stepper.suffix
        }
        Skin.Button {
            implicitWidth: 40
            implicitHeight: 32
            activeColor: "#ffffff"
            enabled: stepper.value < stepper.max
            font.bold: true
            text: "+"
            onClicked: stepper.changed(Math.min(stepper.max, stepper.value + stepper.step))
        }
    }
}
